/node_modules
/.next
/out
/build
# Agent worktrees live here (.claude/worktrees/*), each a full nested checkout
# with its own .next cache. Never committable -- without this, one `git add -A`
# swallows an entire second working copy and its build artifacts.
/.claude
*.tsbuildinfo
next-env.d.ts
.DS_Store
.env*.local
*.log

# Portfolio PNG captures: kept locally as source material, never deployed.
# They are unreachable from any launched page and were shipping 4.34 MB to prod
# for nothing. The two that were actually referenced (chadlewine, risingcompass)
# were re-encoded to .webp on 2026-07-18; the rest are orphans. deploy.sh also
# excludes them from the prod sync, so untracking alone is not load-bearing.
/public/portfolio/*.png
# Same for the JPG originals, as of 2026-07-18: the site serves the .webp
# copies, so these are masters kept on disk, not deployable assets. NOTE the
# leading path and single *: this must NOT match /public/portfolio/wall/*.jpg,
# which IS live and IS tracked.
/public/portfolio/*.jpg

# Parked experiments: kept on disk and preserved in git history (see commit
# 95d4802), but untracked from here on so they never ride along in a diff, a
# deploy, or a status listing. Nothing in here is imported or rendered.
/parked/

# Rendered-text snapshots (scripts/render-diff.mjs) -- build output, tree-specific.
.render-snapshots/

# Lighthouse bench output (scripts/perf-measure.mjs). Local numbers, machine-specific.
.perf/

# Generated at prebuild by scripts/sync-llms-launch.mjs from
# src/content/llms.source.txt (the hand-authored source). Never edit the
# generated copy: the next build overwrites it.
public/llms.txt
